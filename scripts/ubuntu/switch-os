    exit 0
fi

if [ "$TARGET" = "android" ]; then
    SRC="$TPL/android.ini"
else
    SRC="$TPL/ubuntu.ini"
fi

# 涓や釜鏂囦欢閮藉啓鎴愮洰鏍囩郴缁燂紙鍏抽敭鏄唴瀹癸紝涓嶆槸鏂囦欢鍚嶏級
