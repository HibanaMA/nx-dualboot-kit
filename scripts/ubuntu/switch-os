RESTORE=/usr/local/bin/restore-ini.sh

mountpoint -q "$SHARE" || mount /dev/mmcblk0p1 "$SHARE"
mkdir -p "$INI_DIR"

case "$TARGET" in
  android|ubuntu|menu) ;;
  *) echo "鐢ㄦ硶: switch-os android|ubuntu|menu"; exit 1;;
esac

